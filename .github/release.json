{
  "repository": "swift-library/swift-json-schema",
  "version_file": "VERSION",
  "version_pattern": "^([^\\n]+)\\n?$",
  "changelog": "CHANGELOG.md",
  "check_command": "Scripts/check",
  "ci": {
    "include": [
      {
        "name": "macos-15-swift-6.2",
        "runner": "macos-15",
        "xcode": "26.0.1",
        "command": "Scripts/check --compiler-check"
      },
      {
        "name": "macos-26-swift-6.3",
        "runner": "macos-26",
        "xcode": "26.6",
        "command": "Scripts/check --compiler-check"
      },
      {
        "name": "linux-swift-6.2",
        "runner": "ubuntu-24.04",
        "command": "Scripts/check-linux"
      },
      {
        "name": "strict-format",
        "runner": "macos-26",
        "xcode": "26.6",
        "command": "Scripts/check --format-check"
      }
    ]
  },
  "platforms": {
    "iOS": [
      18,
      26,
      27
    ],
    "macOS": [
      15,
      26,
      27
    ]
  },
  "minimum_swift": "6.2",
  "documentation_targets": [
    "JSONValue",
    "JSONSchema",
    "JSONSchemaBuilder",
    "JSONSchemaConversion",
    "JSONSchemaFoundationModels"
  ],
  "linux_image": "swift:6.2.4-noble@sha256:eccc7a97f9b9881d9659e2e788081fd7675f86d39793b51200bfb178398b3784"
